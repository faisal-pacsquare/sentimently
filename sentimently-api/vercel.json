{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "includeFiles": "{dist,data}/**", "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.js" }],
  "crons": [{ "path": "/api/v1/internal/scheduler/run", "schedule": "0 3 * * *" }]
}
