# Copy to .env. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Data store. Default: in memory, seeded from the JSON files in data/ (changes vanish on restart).
# STORAGE_DRIVER=file keeps changes in data/ (local development only).
# STORAGE_DRIVER=file
DATA_DIR=./data
# DATA_WRITE_DIR=

# Durable storage on Vercel (free Upstash Redis from the Vercel Marketplace).
# Vercel sets one of these pairs when you add the integration. Leave empty locally to use the files.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Required in production (the app refuses to start without it). Use a long random value.
JWT_SECRET=change-me-local-only
# No refresh tokens yet, so keep the session long enough for shoppers.
JWT_EXPIRES_IN=7d
# Where the storefront lives: email links and card-payment returns point here (the web app, e.g. http://localhost:5173 in development)
APP_URL=http://localhost:3000
# Creates the first admin at startup if none exists. Remove after first use.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Lost the admin password? Set ADMIN_RESET=true with ADMIN_EMAIL and a NEW ADMIN_PASSWORD, restart, sign in,
# then REMOVE ADMIN_RESET (while it is on, every start puts that password back).
# ADMIN_RESET=true
# Sign-in endpoints allowed per minute per address (default 10); contact form (default 5)
# AUTH_RATE_LIMIT=10
# CONTACT_RATE_LIMIT=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=hello@sentimently.local

# Shared secret for Vercel Cron calls to the scheduler endpoint (the endpoint is off without it)
CRON_SECRET=change-me-local-only
# Where problems that need a person are emailed (failed gifts, overdue refunds, double failed deliveries)
# ALERT_EMAIL=ops@example.com
# GIFT_LINK_RATE_LIMIT=20

# Checkout (default 20 a minute), order tracking (10), gift-card code checks (10)
# CHECKOUT_RATE_LIMIT=20
# TRACK_RATE_LIMIT=10
# CODE_CHECK_RATE_LIMIT=10

# Feature flags
# Card payments also need a real gateway adapter; with none installed this flag does nothing.
FEATURE_CARD_PAYMENTS=false

# Rate limiting (in-memory, per instance)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ---- Hardening (B6) ----
# Browsers on these origins may call the API (comma separated). Leave empty to allow none.
# CORS_ORIGINS=https://shop.example.pk,https://admin.example.pk
# Production refuses to start unless JWT_SECRET has 32+ characters, CRON_SECRET (if set) 16+, ADMIN_PASSWORD (if ADMIN_EMAIL set) 12+.
# Server errors (5xx) are also posted here as {"text": "..."}, at most once a minute per error (Slack-style webhook)
# ERROR_WEBHOOK_URL=
# One JSON line per request (route pattern, status, time). Automatic in production; set to true to see it locally.
# LOG_REQUESTS=true
# LOG_LEVEL=log
# Finished orders lose personal details after this many days (default 730). A policy decision for the studio.
# RETENTION_DAYS=730
# Set to false to stop serving /api/v1/openapi.json
# OPENAPI_PUBLIC=true
# Set when a proxy you control sits in front (Vercel sets VERCEL itself), so rate limits see real client addresses
# TRUST_PROXY=1

# ---- Card payments: Safepay (hosted checkout) ----
# All four must be set, plus FEATURE_CARD_PAYMENTS=true, before card appears at checkout.
# SAFEPAY_ENV=sandbox            # or production
# SAFEPAY_API_KEY=               # public key (merchant_api_key); sandbox and live keys differ
# SAFEPAY_SECRET_KEY=            # server key, sent as X-SFPY-MERCHANT-SECRET. Never put in the web app.
# SAFEPAY_WEBHOOK_SECRET=        # Dashboard > Developers > Endpoints > shared secret. Point the endpoint at POST /api/v1/payments/webhook
# FEATURE_CARD_PAYMENTS=true
